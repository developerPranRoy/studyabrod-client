# AbroadMates client environment variables
# Copy to .env.local for local development. NEXT_PUBLIC_* values are inlined
# into the browser bundle at BUILD time, so rebuild after changing them.

# Base URL of the AbroadMates Web API (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Origin of the API, used to turn "/uploads/photos/..." into absolute image URLs
NEXT_PUBLIC_API_ORIGIN=http://localhost:5000

# Cloudflare Turnstile site key (leave empty to hide the widget in development)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Google Identity Services client id (empty hides the Google button)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Public URL of this client, used for share/referral/profile links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
